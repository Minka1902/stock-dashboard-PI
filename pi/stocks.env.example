# Settings and secrets for the Raspberry Pi service.
#
# install.sh copies this to /etc/stocks-dashboard/stocks.env (root:stocks, 640)
# on the first install and never overwrites it. Edit that copy, then apply it:
#
#     sudo systemctl restart stocks-dashboard
#
# Nothing in the app loads a .env file: systemd passes this file to the
# service (EnvironmentFile=). Everything is optional — notification channels
# and keyed sources no-op and say so on the Server page when unset.
# FORMAT: KEY=VALUE, one per line, # starts a comment, no quotes needed.
#
# Set by install.sh in /etc/stocks-dashboard/install.env (which wins), so do
# not add them here: STOCKS_DB_PATH, STOCKS_LOG_DIR, STOCKS_BACKUP_DIR,
# STOCKS_CORS_ORIGINS, STOCKS_OAUTH_REDIRECT_BASE, STOCKS_COOKIE_SECURE,
# STOCKS_HSTS_SECONDS, STOCKS_TRUSTED_PROXY_IPS.

# --- Who may sign up ---
# approval: anyone who can reach the Pi may sign up and set up 2FA, but sees
# nothing until the admin approves the account on the Server page. Only
# STOCKS_ADMIN_EMAIL is approved (and admin) automatically.
# Other modes: open | invite (with STOCKS_INVITE_CODE) | closed.
STOCKS_REGISTRATION=approval
STOCKS_ADMIN_EMAIL=
# STOCKS_INVITE_CODE=

# --- Core ---
# STOCKS_LOG_LEVEL=INFO
# Default cadence of the fast sources, in seconds. Per-source schedules are
# edited on the Server page; this only seeds new ones.
# STOCKS_REFRESH_SECONDS=180
# STOCKS_SCHEDULE_TZ=Asia/Jerusalem

# --- Running unattended ---
# Copies of the DB the nightly db_backup job keeps (point STOCKS_BACKUP_DIR in
# install.env at a mounted USB stick to survive a dead SD card).
# STOCKS_BACKUP_KEEP=7
# STOCKS_BACKUP_HOUR=3
# STOCKS_BACKUP_MINUTE=47
# /api/health reports "degraded" (and the healthcheck timer restarts the
# service) once a fetch or queued job has waited this long.
# STOCKS_HEALTH_STUCK_SECONDS=1800
# Plain TCP connects that decide "online"; while none connects, network
# sources defer and re-run the moment one does.
# STOCKS_NETCHECK_HOSTS=1.1.1.1:443,8.8.8.8:53
# STOCKS_NETCHECK_INTERVAL_SECONDS=30

# --- Data sources ---
# SEC requires a descriptive User-Agent with contact info for fair access.
# STOCKS_SEC_USER_AGENT=Signal Dashboard you@example.com
# Optional Alpha Vantage key (primary for technicals; Yahoo fallback if unset).
# STOCKS_ALPHA_VANTAGE_KEY=
# Optional Financial Modeling Prep key for official econ-calendar impact ratings.
# STOCKS_FMP_KEY=
# STOCKS_ECON_CALENDAR_COUNTRIES=United States
# House Clerk PTR filings read per run (needs pdftotext; install.sh installs it).
# STOCKS_CONGRESS_PTR_PER_RUN=25
# Famous investors' 13F holdings: narrow the built-in filer list to these CIKs.
# STOCKS_13F_FILERS=1067983,1336528
# Margin debt: the last tier drives the system chromium. Budget in seconds.
# STOCKS_MARGIN_DEBT_BROWSER_TIMEOUT_SECONDS=180
# STOCKS_CHROMIUM_PATH=/usr/bin/chromium

# --- X (Twitter) watcher ---
# STOCKS_X_ACCOUNTS=realDonaldTrump,aistocksavvy
# Official API v2 bearer. Unset falls back to Nitter mirrors, which still store
# posts but flag the source as a warning until a real key is configured.
# STOCKS_X_BEARER=

# --- Email digest (SMTP; works with a Gmail app password) ---
# STOCKS_SMTP_HOST=
# STOCKS_SMTP_PORT=587
# STOCKS_SMTP_USER=
# STOCKS_SMTP_PASSWORD=
# STOCKS_SMTP_FROM=
# STOCKS_DIGEST_HOUR=7
# STOCKS_DIGEST_MINUTE=30
# STOCKS_DIGEST_TZ=America/New_York

# --- SMS digest (Twilio) ---
# STOCKS_TWILIO_ACCOUNT_SID=
# STOCKS_TWILIO_AUTH_TOKEN=
# STOCKS_TWILIO_FROM_PHONE=

# --- Telegram bot (alerts, sign-ups, bot fills, read-only commands) ---
# Token from @BotFather; each user links a chat in Settings -> Telegram.
# STOCKS_TELEGRAM_BOT_TOKEN=

# --- Alpaca broker (paper account; keys from alpaca.markets) ---
# STOCKS_ALPACA_KEY_ID=
# STOCKS_ALPACA_SECRET_KEY=
# STOCKS_ALPACA_OWNER=

# --- OAuth sign-in (optional; email + password + 2FA always works) ---
# Each provider is offered once both its id and secret are set. Register this
# callback with the provider (it is compared byte for byte):
#   https://<pi>.<tailnet>.ts.net/api/auth/oauth/<provider>/callback
# STOCKS_OAUTH_GITHUB_CLIENT_ID=
# STOCKS_OAUTH_GITHUB_CLIENT_SECRET=
# STOCKS_OAUTH_GOOGLE_CLIENT_ID=
# STOCKS_OAUTH_GOOGLE_CLIENT_SECRET=
# STOCKS_OAUTH_FACEBOOK_CLIENT_ID=
# STOCKS_OAUTH_FACEBOOK_CLIENT_SECRET=

# --- Trading bot: costs, demo bots, paper account ---
# STOCKS_COST_BPS_PER_SIDE=10
# STOCKS_BOT_MAX_BOTS=10
# STOCKS_BOT_INTERVAL_SECONDS=60
# STOCKS_EXITS_INTERVAL_SECONDS=60
# STOCKS_PAPER_START_CASH=100000
# STOCKS_PAPER_START_CURRENCY=USD
# STOCKS_BENCHMARKS=SPY,^TA125.TA

# --- Market-wide scanner ---
# Union of: majors, mine (held + watched), sp500, ndx100, ta125. Bigger
# universes cost a Pi 3 more refresh-thread time per run; watch the Server
# page's queue before widening this.
# STOCKS_SCANNER_UNIVERSES=majors,mine
# STOCKS_SCANNER_MAX_TICKERS=600
# STOCKS_SCANNER_INTERVAL_SECONDS=300
# STOCKS_SCANNER_ALERTS_PER_HOUR=3

# The regime thresholds (STOCKS_REGIME_*), signal auto-mute (STOCKS_SIGNAL_*)
# and every other knob are listed with their defaults in backend/app/config.py.
